# Copy to .env and fill in. Never commit .env.

# --- Required -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Used by docker compose for the Postgres container and the API/worker connection string.
POSTGRES_PASSWORD=

# --- Local (non-Docker) runs ------------------------------------------------
# docker compose overrides these two with in-network addresses.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/codeflow
REDIS_URL=redis://localhost:6381/0

# --- API --------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# JSON list or comma-separated. Only needed when the UI is served from a different origin than the API.
CORS_ORIGINS=http://localhost:5173
MAX_ACTIVE_JOBS_PER_USER=5

# --- Worker / sandbox --------------------------------------------------------
WORKER_CONCURRENCY=2
EXECUTION_TIMEOUT_SECONDS=10
EXECUTOR_CPUS=1.0
# Per-language overrides: PYTHON_IMAGE, JAVA_IMAGE, CPP_IMAGE, PYTHON_MEMORY_LIMIT, JAVA_MEMORY_LIMIT, CPP_MEMORY_LIMIT

# Host ports (change if they clash with something else on your machine)
API_PORT=8000
WEB_PORT=5173
